# secrets — never commit
.env
.env.*
!.env.example

# durable runtime state — genome archive + market cache are rebuildable
# side effects of `evolve`, not the source of truth (live_state.json is).
# Ignoring all of state/, not just state/cache/, because GENOME_DIR resolves
# relative to cwd regardless of EVO_STATE, so an `evolve` invoked from the
# repo root (even one meant to be a shadow/offline run) writes archive files
# here unless the whole directory is ignored.
state/
*.pkl

# python
__pycache__/
*.py[cod]
.venv/
venv/

# Private working docs — local only, never committed.
# Agent-facing context lives in AGENTS.md; run notes go in runs/.
docs/
